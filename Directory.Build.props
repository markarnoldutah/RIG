<Project>

  <!--
    Settings shared by every .NET project in the repo. Target frameworks stay in each
    csproj because BigRig.Mobile multi-targets (net10.0-android;net10.0-ios).
  -->
  <PropertyGroup>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
